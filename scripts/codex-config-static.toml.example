# ~/.codex/config.toml -- codexferry wiring, STATIC catalog mode.
#
# Copy to ~/.codex/config.toml (merge with your own approval/sandbox/projects
# settings). codex pins a catalog FILE generated by `codexferry gen-catalog`
# and never contacts the /models endpoint. Prefer this mode when you want:
#   - a pure model list (dynamic mode merges codex's bundled gpt models in);
#   - zero /models dependency on any codex version (an env_key-only provider
#     without Codex-backed auth never fetches; the pin makes this mode fully
#     independent of the endpoint regardless).
# Trade-off: the file is a SNAPSHOT - re-run gen-catalog after changing routes
# or upgrading codex, then restart codex.

# 1. Generate the catalog (re-run whenever cxf.toml routes change):
#      codexferry gen-catalog --config cxf.toml \
#        --out ~/.codex/codexferry-catalog.json
# 2. Relative paths resolve against ~/.codex/ (CODEX_HOME).
model = "deepseek/deepseek-v4-flash"      # any configured route key
model_provider = "codexferry"
model_catalog_json = "codexferry-catalog.json"

[model_providers.codexferry]
name = "codexferry"
base_url = "http://127.0.0.1:8787/v1"     # must match [server] in cxf.toml
wire_api = "responses"
# env_key is fine in static mode: the catalog file supplies all model
# metadata, so the provider's auth shape does not matter for the catalog.
# Non-empty value required by codex; the router does not authenticate clients.
env_key = "CODEXFERRY_DUMMY"

# ...and export the dummy var in your shell profile:
#      export CODEXFERRY_DUMMY="dummy"
#
# Dynamic mode (live /models fetch, no regeneration on route changes)
# instead? See codex-config-dynamic.toml.example next to this file.
